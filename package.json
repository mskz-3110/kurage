{
  "name": "kurage",
  "version": "0.2.0",
  "description": "Flexible JavaScript runtime.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mskz-3110/kurage.git"
  },
  "homepage": "https://github.com/mskz-3110/kurage",
  "author": "mskz-3110",
  "keywords": [
    "typescript",
    "cli",
    "command-line",
    "repl",
    "runtime",
    "shell",
    "script",
    "automation"
  ],
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "bin": {
    "kurage": "./dist/cli/kurage.js"
  },
  "main": "./dist/kurage.js",
  "types": "./dist/kurage.d.ts",
  "exports": {
    ".": {
      "types": "./dist/kurage.d.ts",
      "import": "./dist/kurage.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "install:frozen": "pnpm install --frozen-lockfile",
    "docker:build": "docker compose build minimum develop",
    "docker:min": "docker compose run --rm minimum bash",
    "docker:dev": "docker compose run --rm develop bash",
    "docker:vhs": "docker compose run --rm develop bash -c 'node tools/readme/vhs.js'",
    "build:src": "biome check --write src && rolldown --config && biome format dist --write && tsc --emitDeclarationOnly --declaration && rm -f dist/cli/*.d.ts && biome check --write .",
    "build:bin": "bun build src/cli/kurage.ts --compile --compile-autoload-package-json --outfile bin/kurage",
    "build": "pnpm run build:src && pnpm run build:bin",
    "test": "vitest run --coverage",
    "ci": "pnpm run build && pnpm run test",
    "upgrade": "mise upgrade --bump",
    "v:patch": "npm version patch",
    "v:minor": "npm version minor",
    "v:major": "npm version major"
  },
  "engines": {
    "node": ">=22.23.4",
    "bun": ">=1.4.4",
    "pnpm": ">=12.15.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "rolldown": "^1.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
