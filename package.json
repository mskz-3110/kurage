{
  "name": "kurage",
  "version": "0.1.0",
  "description": "Flexible JavaScript runtime.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mskz-3110/kurage.git"
  },
  "homepage": "https://github.com/mskz-3110/kurage",
  "author": "mskz-3110",
  "keywords": [
    "typescript",
    "cli",
    "command-line",
    "repl",
    "runtime",
    "shell",
    "script",
    "automation"
  ],
  "type": "module",
  "bin": {
    "kurage": "./dist/cli/kurage.js"
  },
  "main": "./dist/kurage.js",
  "types": "./dist/kurage.d.ts",
  "exports": {
    ".": {
      "types": "./dist/kurage.d.ts",
      "import": "./dist/kurage.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "install:frozen": "pnpm install --frozen-lockfile",
    "docker:build": "docker compose up -d --build kurage-minimum && docker compose build --no-cache kurage-develop && docker compose up -d kurage-develop",
    "docker:min": "docker compose run --rm kurage-minimum bash",
    "docker:dev": "docker compose run --rm kurage-develop bash",
    "docker:vhs": "docker compose run -e PS1='$ ' --rm kurage-develop bash -c 'node tools/readme/generate-assets.js'",
    "build:src": "biome check --write src && rolldown --config && biome format dist --write && tsc --emitDeclarationOnly --declaration && rm -f dist/cli/*.d.ts && biome check --write .",
    "build:bin": "bun build src/cli/kurage.ts --compile --compile-autoload-package-json --outfile bin/kurage",
    "build": "npm run build:src && npm run build:bin",
    "chmod:all": "node tools/chmod-all.js",
    "test": "vitest run --coverage",
    "ci": "npm run build && npm run test"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.0",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "rolldown": "^1.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
