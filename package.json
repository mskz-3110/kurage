{
  "name": "kurage",
  "version": "0.1.0",
  "description": "A flexible runtime for REPL, exec, and run.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mskz-3110/kurage.git"
  },
  "homepage": "https://github.com/mskz-3110/kurage",
  "author": "mskz-3110",
  "keywords": [
    "typescript",
    "cli",
    "command-line",
    "repl",
    "runtime",
    "shell",
    "script",
    "automation"
  ],
  "type": "module",
  "bin": {
    "kurage": "./dist/cli/kurage.js"
  },
  "main": "./dist/kurage.js",
  "types": "./dist/kurage.d.ts",
  "exports": {
    ".": {
      "types": "./dist/kurage.d.ts",
      "import": "./dist/kurage.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "docker:build": "docker compose up -d --build",
    "docker:bash": "docker compose run --rm kurage bash",
    "docker:vhs": "docker compose run -e PS1='$ ' --rm kurage bash -c 'node tools/readme/vhs.js'",
    "build:js": "rolldown --config && biome format dist --write",
    "build:dts": "tsc --emitDeclarationOnly --declaration && rm -f dist/cli/*.d.ts",
    "build:bin": "bun build src/cli/kurage.ts --compile --compile-autoload-package-json --outfile bin/kurage",
    "build": "biome check --write src && npm run build:js && npm run build:dts && biome check --write .",
    "chmod": "chmod +x dist/cli/*.js scripts/*.js examples/*.js tools/**/*.js && git update-index --chmod=+x dist/cli/*.js scripts/*.js examples/*.js tools/**/*.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^26.0.1",
    "rolldown": "^1.1.3",
    "typescript": "^6.0.3"
  }
}
